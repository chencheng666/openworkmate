{
  "name": "openworkmate",
  "version": "0.1.0-alpha.1",
  "description": "OpenWorkMate - 面向企业内部业务和企业数据的 AI 智能体平台",
  "author": "OpenWorkMate 贡献者",
  "repository": {
    "type": "git",
    "url": "https://github.com/chencheng666/openworkmate.git"
  },
  "homepage": "https://github.com/chencheng666/openworkmate",
  "bugs": {
    "url": "https://github.com/chencheng666/openworkmate/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "upgrade:lab": "node scripts/upgrade/lab.mjs",
    "upgrade:accept": "node scripts/upgrade/lab.mjs accept",
    "dev": "pnpm -r --parallel run dev",
    "desktop": "node scripts/desktop.mjs",
    "start": "pnpm --dir backend start:platform",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:enterprise": "pnpm test",
    "test:e2e": "pnpm --dir web-app test:e2e",
    "admin:dev": "pnpm --dir admin-web dev",
    "admin:build": "pnpm --dir admin-web build",
    "web:dev": "pnpm --dir web-app dev",
    "web:build": "pnpm --dir web-app build",
    "backend:dev": "pnpm --dir backend dev",
    "backend:seed": "pnpm --dir backend seed",
    "backend:smoke:knowledge": "pnpm --dir backend smoke:knowledge",
    "check:public": "node scripts/check-public-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "marked": "15.0.12",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
